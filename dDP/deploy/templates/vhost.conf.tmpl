# dDP 项目 vhost —— 宿主 nginx 边缘(443)→ rootless php-fpm 容器(127.0.0.1)。
# root 指宿主上的 src/public(静态/try_files);SCRIPT_FILENAME 用容器内路径(php-fpm 自解析)。
# TLS 暂用自签证书,域名就绪后 certbot 换真证。不抢 default_server(占位 vhost 仍在)。
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate     /etc/nginx/ssl/selfsigned.crt;
    ssl_certificate_key /etc/nginx/ssl/selfsigned.key;
    include snippets/tls.conf;
    include snippets/security-headers.conf;
    include snippets/deny-dotfiles.conf;

    root __ROOT__;
    index index.php;
    client_max_body_size 20m;

    location / {
        try_files $uri $uri/ @thinkphp;
    }

    location @thinkphp {
        include snippets/ratelimit.conf;
        include fastcgi_params;
        fastcgi_pass 127.0.0.1:__PORT__;
        fastcgi_param SCRIPT_FILENAME /var/www/__NAME__/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/__NAME__/public;
        fastcgi_param PATH_INFO $uri;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param QUERY_STRING $query_string;
        fastcgi_param HTTPS on;
        fastcgi_param X-Forwarded-Proto $scheme;
        fastcgi_hide_header X-Powered-By;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_pass 127.0.0.1:__PORT__;
        fastcgi_param SCRIPT_FILENAME /var/www/__NAME__/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/__NAME__/public;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param QUERY_STRING $query_string;
        fastcgi_param HTTPS on;
        fastcgi_param X-Forwarded-Proto $scheme;
        fastcgi_hide_header X-Powered-By;
    }
}
